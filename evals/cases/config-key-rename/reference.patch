+++ b/fetcher/config.py
@@ -1,9 +1,14 @@
 import json
+import warnings
 from pathlib import Path
 
-DEFAULTS = {"timeout": 10, "retries": 3}
+DEFAULTS = {"request_timeout_s": 10, "retries": 3}
 
 
 def load(path: str | Path) -> dict:
     """Read a config file and fill in defaults."""
-    return {**DEFAULTS, **json.loads(Path(path).read_text())}
+    data = json.loads(Path(path).read_text())
+    if "timeout" in data:
+        warnings.warn("config key 'timeout' is deprecated; use 'request_timeout_s'", DeprecationWarning, stacklevel=2)
+        data.setdefault("request_timeout_s", data.pop("timeout"))
+    return {**DEFAULTS, **data}
