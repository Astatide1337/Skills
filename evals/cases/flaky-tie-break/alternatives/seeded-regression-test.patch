@@ -18,5 +18,14 @@ class QueueTests(unittest.TestCase):
         self.assertEqual(q.next_jobs(3), ["urgent", "backup", "reindex"])
 
 
+    def test_tie_order_is_stable_across_hash_seeds(self):
+        import os, subprocess, sys
+        for seed in range(10):
+            env = {**os.environ, "PYTHONHASHSEED": str(seed)}
+            code = "from scheduler.queue import JobQueue\nq = JobQueue()\nfor n in ['a', 'b', 'c']: q.submit(n, 1)\nprint(q.next_jobs(3))"
+            out = subprocess.run([sys.executable, "-c", code], env=env, capture_output=True, text=True).stdout
+            self.assertEqual(out.strip(), "['a', 'b', 'c']")
+
+
 if __name__ == "__main__":
     unittest.main()
