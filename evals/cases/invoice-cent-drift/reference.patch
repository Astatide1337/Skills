diff --git a/ledger/money.py b/ledger/money.py
index df98de4..3756ff2 100644
--- a/ledger/money.py
+++ b/ledger/money.py
@@ -1,3 +1,11 @@
-def fmt(amount: float) -> str:
+from decimal import ROUND_HALF_UP, Decimal
+
+
+def cents(amount) -> Decimal:
+    """Round an amount to cents the way invoices print it."""
+    return Decimal(str(amount)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def fmt(amount) -> str:
     """Format an amount for printing on an invoice."""
-    return f"{round(amount, 2):.2f}"
+    return f"{cents(amount):.2f}"
