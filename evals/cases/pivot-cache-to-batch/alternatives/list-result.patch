     return rows[0][0] if rows else None
+
+
+def resolve_many(db: Database, codes: list[str]) -> list[str | None]:
+    """Targets aligned with codes, in one query."""
+    if not codes:
+        return []
+    marks = ",".join("?" * len(codes))
+    found = dict(db.query(f"select code, target from links where code in ({marks})", tuple(codes)))
+    return [found.get(code) for code in codes]
