diff --git a/shortlinks/resolver.py b/shortlinks/resolver.py
index b8af6e2..0867c3e 100644
--- a/shortlinks/resolver.py
+++ b/shortlinks/resolver.py
@@ -4,3 +4,12 @@ from shortlinks.db import Database
 def resolve(db: Database, code: str) -> str | None:
     rows = db.query("select target from links where code = ?", (code,))
     return rows[0][0] if rows else None
+
+
+def resolve_many(db: Database, codes: list[str]) -> dict[str, str | None]:
+    """Targets for many codes in one query; unknown codes map to None."""
+    if not codes:
+        return {}
+    marks = ",".join("?" * len(codes))
+    found = dict(db.query(f"select code, target from links where code in ({marks})", tuple(codes)))
+    return {code: found.get(code) for code in codes}
