      "signals": [
        "end-to-end",
        "recovery",
        "isolation",
        "regressions",
        "scope",
        "resource-use"
      ],
      "gap": "Calibrated defect and clean reviews need semantic artifact review; local tasks do not cover live production."
    },
    "workflow-automation": {
      "local_suites": [
        "engineering_workflows",
        "catalog"
      ],
      "external": [
        "terminal-bench"
      ],
      "signals": [
        "repeatability",
        "failure-recovery",
        "bounded-experiment",
        "resource-use"
      ],
      "gap": "Benchmark scenario selection must actually exercise workflow/optimization behavior, not incidental routing."
    },
    "catalog-admin": {
      "local_suites": [
        "catalog",
        "routing"
      ],
      "external": [],
      "signals": [
        "trigger-precision",
        "trigger-recall",
        "heldout-generalization"
      ],
      "gap": "Catalog structural validity is not behavior efficacy; evaluate skill changes on the affected task family."
    }
  }
