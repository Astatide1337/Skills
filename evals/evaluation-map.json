{
  "version": 1,
  "policy": {
    "primary_engineering_suite": "engineering_workflows",
    "preserve_small_checks_for": "routing, mechanics, regression localization",
    "publish_results": false,
    "results_directory": "evals/results",
    "compare": "frozen matched catalogs; single-component ablation after observed gap",
    "holdout": "explicit selection only after candidate frozen",
    "promotion": "Freeze acceptance and budget before trial; require behavior/authority gates, independently reviewed artifacts, improvement across matched cases and repetitions, and unchanged heldout confirmation. A quality tie is no demonstrated quality gain; do not rank individual skills from whole-catalog runs.",
    "next_experiment": "Trial one component against an observed gap, then complementary pairs and leave-one-out removal; no automatic promotion from a saturated pilot.",
    "tool_value_plan": "evals/tool-value-plan.json"
  },
  "tiers": {
    "smoke": "mechanics and narrow boundary checks",
    "challenge": "multi-module executable contracts and named behavioral groups",
    "external": "upstream CLI benchmarks with frozen tasks and catalogs",
    "artifact-review": "independent blinded assessment where semantics cannot be checked deterministically"
  },
  "metrics": {
    "measured": [
      "named behavioral acceptance",
      "workspace scope",
      "native input/cached/output/reasoning tokens",
      "completed command items",
      "command exit failures",
      "agent message items",
      "observed guidance references",
      "Inspect elapsed timestamps",
      "conditional executable-review precision, recall, unsubstantiated findings, duplicates and missed known defects"
    ],
    "descriptive_only": [
      "changed-file count",
      "guidance references",
      "command counts"
    ],
    "requires_new_evidence": [
      "true repair-attempt count",
      "first verified success timestamp",
      "human correction count",
      "regressions outside defined test corpus",
      "unnecessary complexity",
      "claim accuracy",
      "semantic review correctness and proof authenticity"
    ],
    "unknown": [
      "monetary subscription cost",
      "provider internal effort settings",
      "unobserved effects"
    ]
  },
  "skill_coverage": [
