      ],
      "signals": [
        "user-flow-completion",
        "keyboard-access",
        "responsive-behavior"
      ],
      "gap": "Current native local runner cannot prove browser interaction; require an actual supported browser benchmark before comparison."
    },
    "internet-research": {
      "local_suites": [
        "catalog"
      ],
      "external": [],
      "signals": [
        "source-accuracy",
        "claim-support",
        "coverage"
      ],
      "gap": "Fresh web research needs live source access and independent citation review; synthetic fixtures are insufficient."
    },
    "production-engineering": {
      "local_suites": [
        "engineering_workflows",
        "harder_workflows",
        "review_workflows",
        "tool_value_workflows"
