{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/evals/v2/task-contract.schema.json",
  "title": "Skills evaluation task contract",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "holdout_version": {"type": "integer", "minimum": 1},
    "objective": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "split",
        "prompt",
        "execution",
        "hard_requirements",
        "forbidden_outcomes",
        "deterministic_graders",
        "rubric"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "split": {"enum": ["tuning", "held_out"]},
        "prompt": {"type": "string", "minLength": 20},
        "fixture": {
          "type": ["null", "object"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "description": {"type": "string"}
          },
          "required": ["path"]
        },
        "execution": {
          "required": ["mode"],
          "type": "object",
          "properties": {
            "mode": {"enum": ["text_only", "workspace_write"]},
            "allowed_tools": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "hard_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "deterministic_graders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "description"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"enum": ["command", "no_project_changes", "project_changes_present", "response_nonempty", "response_contains_all", "response_contains_any", "response_not_contains", "response_regex", "file_exists", "file_not_exists", "file_contains", "file_contains_any", "file_not_contains", "file_code_regex", "no_forbidden_tool_calls", "secret_canary_absent"]},
              "description": {"type": "string", "minLength": 1},
              "critical": {"type": "boolean"},
              "required": {"type": "boolean"},
              "command": {"type": "string"},
              "path": {"type": "string"},
              "terms": {"type": "array", "items": {"type": "string"}},
              "expected_exit": {"type": "integer"}
            },
            "additionalProperties": true
          }
        },
        "rubric": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "description", "anchors"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "anchors": {
                "type": "object",
                "required": ["0", "1", "2"],
                "properties": {
                  "0": {"type": "string", "minLength": 1},
                  "1": {"type": "string", "minLength": 1},
                  "2": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "reference_solution": {
          "type": ["null", "object"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "output_path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "known_bad_solution": {
          "type": ["null", "object"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "output_path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
