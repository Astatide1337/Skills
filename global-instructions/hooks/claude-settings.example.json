{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$SKILLS_DIR/global-instructions/hooks/agent_gates.py\" session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$SKILLS_DIR/global-instructions/hooks/agent_gates.py\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$SKILLS_DIR/global-instructions/hooks/agent_gates.py\" format",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$SKILLS_DIR/global-instructions/hooks/agent_gates.py\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
